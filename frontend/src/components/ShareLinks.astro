---
import { siMastodon, siBluesky, siThreads, siReddit } from 'simple-icons';

interface Props {
	title: string;
	slug: string;
}

const { title, slug } = Astro.props;
const postUrl = new URL(`/blog/${slug}/`, Astro.site).href;
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(postUrl);

const linkedinPath = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';

const links = [
	{
		label: 'Share on Mastodon',
		href: `https://tootpick.org/#text=${encodedTitle}%20${encodedUrl}`,
		icon: siMastodon.path,
	},
	{
		label: 'Share on Bluesky',
		href: `https://bsky.app/intent/compose?text=${encodedTitle}%20${encodedUrl}`,
		icon: siBluesky.path,
	},
	{
		label: 'Share on LinkedIn',
		href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
		icon: linkedinPath,
	},
	{
		label: 'Share on Threads',
		href: `https://www.threads.net/intent/post?text=${encodedTitle}%20${encodedUrl}`,
		icon: siThreads.path,
	},
	{
		label: 'Share on Reddit',
		href: `https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`,
		icon: siReddit.path,
	},
];

const emailHref = `mailto:?subject=${encodedTitle}&body=${encodedUrl}`;
---

<aside class="share-links" id="share-links" aria-label="Share this post">
	{links.map(({ href, label, icon }) => (
		<a href={href} target="_blank" rel="noopener noreferrer" aria-label={label} title={`${label} · Always tracker-free 🩷`}>
			<svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<path d={icon} />
			</svg>
		</a>
	))}
	<a href={emailHref} aria-label="Share via email" title="Share via email · Always tracker-free 🩷">
		<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
			<path d="M2 4h20v16H2V4zm18 2l-8 5-8-5v2l8 5 8-5V6z" />
		</svg>
	</a>
	<button class="share-copy" aria-label="Copy link" title="Copy link" data-url={postUrl}>
		<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
			<path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7a5 5 0 0 0 0 10h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1ZM8 13h8v-2H8v2Zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4a5 5 0 0 0 0-10Z" />
		</svg>
	</button>

</aside>

<style>
	.share-links {
		position: fixed;
		left: 1.5rem;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		z-index: 90;
	}
	.share-links a,
	.share-links button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		color: var(--text-muted);
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 8px;
		text-decoration: none;
		cursor: pointer;
		transition: color 0.2s ease, border-color 0.2s ease;
	}
	.share-links a:hover,
	.share-links button:hover {
		color: var(--accent);
		border-color: var(--accent);
		text-decoration: none;
	}
	.share-links svg {
		width: 18px;
		height: 18px;
		fill: currentColor;
	}
	@media (max-width: 1200px) {
		.share-links {
			position: static;
			transform: none;
			flex-direction: row;
			justify-content: center;
			gap: 0.5rem;
			margin: 2rem 0 0 0;
			padding-top: 1.5rem;
			border-top: 1px solid var(--border);
		}
	}
	@media print {
		.share-links { display: none !important; }
	}
</style>

<script>
	const copyBtn = document.querySelector('.share-copy') as HTMLButtonElement;
	if (copyBtn) {
		copyBtn.addEventListener('click', async () => {
			const url = copyBtn.dataset.url ?? '';
			await navigator.clipboard.writeText(url);
			const svg = copyBtn.querySelector('svg')!;
			const originalPath = svg.innerHTML;
			svg.innerHTML = '<path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" />';
			setTimeout(() => { svg.innerHTML = originalPath; }, 1500);
		});
	}
</script>
