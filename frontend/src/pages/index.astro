---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const publishedPosts = allPosts
	.filter((p) => p.data.status === 'published')
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featuredPosts = publishedPosts.filter((p) => p.data.featured);
const recentPosts = publishedPosts.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				display: flex;
				align-items: center;
				gap: 3rem;
				padding: 3rem 0 4rem;
				border-bottom: 1px solid var(--border);
			}
			.hero-photo {
				flex-shrink: 0;
				width: 180px;
				height: 180px;
				border-radius: 50%;
				border: 3px solid var(--accent);
				background-image: url('/profile.png');
				background-size: cover;
				background-position: center 20%;
			}
			.hero-content {
				flex: 1;
			}
			.hero-name {
				font-family: monospace;
				font-size: 2.8rem;
				font-weight: 700;
				margin: 0 0 0.25rem 0;
				background: linear-gradient(90deg, var(--accent), var(--accent-2));
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}
			.hero-tagline {
				font-family: monospace;
				color: var(--text-muted);
				font-size: 1rem;
				margin: 0 0 1.25rem 0;
				letter-spacing: 0.05em;
			}
			.hero-bio {
				font-size: 1.05rem;
				line-height: 1.7;
				color: var(--text);
				margin: 0;
				max-width: 540px;
			}
			section {
				padding: 3rem 0;
				border-bottom: 1px solid var(--border);
			}
			section:last-child {
				border-bottom: none;
			}
			.section-heading {
				font-family: monospace;
				font-size: 1rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--text-muted);
				margin: 0 0 2rem 0;
			}
			.post-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5rem;
			}
			.post-card {
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: 12px;
				overflow: hidden;
				transition: box-shadow 0.2s ease, transform 0.2s ease;
			}
			.post-card:hover {
				box-shadow: var(--box-shadow);
				transform: translateY(-2px);
			}
			.post-card a {
				display: flex;
				flex-direction: column;
				height: 100%;
				color: inherit;
				text-decoration: none;
			}
			.post-card img {
				width: 100%;
				height: 160px;
				object-fit: cover;
				border-radius: 0;
			}
			.post-card-body {
				padding: 1.25rem;
				flex: 1;
				display: flex;
				flex-direction: column;
			}
			.post-card-title {
				font-size: 1.1rem;
				font-weight: 700;
				margin: 0 0 0.5rem 0;
				line-height: 1.3;
				color: var(--text);
			}
			.post-card-date {
				font-family: monospace;
				font-size: 0.9rem;
				color: var(--text-muted);
				margin-top: auto;
			}
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0;
			}
			.post-list-item {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
				padding: 0.85rem 0;
				border-bottom: 1px solid var(--border);
			}
			.post-list-item:last-child {
				border-bottom: none;
			}
			.post-list-item a {
				color: var(--text);
				font-weight: 500;
			}
			.post-list-item a:hover {
				color: var(--accent);
				text-decoration: none;
			}
			.post-list-date {
				font-family: monospace;
				font-size: 0.9rem;
				color: var(--text-muted);
				white-space: nowrap;
			}
			.hero-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem 1.25rem;
				margin-top: 1.25rem;
			}
			.hero-links a {
				font-family: monospace;
				font-size: 1rem;
				color: var(--text-muted);
				text-decoration: none;
				letter-spacing: 0.03em;
			}
			.hero-links a:hover {
				color: var(--accent);
				text-decoration: none;
			}
			@media (max-width: 720px) {
				.hero {
					flex-direction: column;
					text-align: center;
					gap: 1.5rem;
					padding: 2rem 0 3rem;
				}
				.hero-bio {
					max-width: 100%;
				}
				.hero-name {
					font-size: 2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-photo" role="img" aria-label="Laura Langdon"></div>
				<div class="hero-content">
					<h1 class="hero-name">Laura Langdon</h1>
					<p class="hero-tagline">// Community Manager · UC OSPO Network</p>
					<p class="hero-bio">
						Hello! I'm Laura, and I'm passionate about community, diversity and
						inclusion across all axes, and open source as a force for public good. I find
						camaraderie with folks who value social responsibility in tech and are
						enormous nerds.
					</p>
					<nav class="hero-links">
						<a href="https://github.com/LauraLangdon">GitHub</a>
						<a href="https://hachyderm.io/@LauraLangdon" rel="me">Mastodon</a>
						<a href="https://bsky.app/profile/lauralangdon.io">Bluesky</a>
						<a href="https://linkedin.com/in/laura-langdon">LinkedIn</a>
						<a href="https://twitch.tv/LauraLangdon">Twitch</a>
						<a href="https://youtube.com/@laura-langdon">YouTube</a>
					</nav>
				</div>
			</section>

			{featuredPosts.length > 0 && (
				<section>
					<p class="section-heading">Featured</p>
					<div class="post-grid">
						{featuredPosts.map((post) => (
							<div class="post-card">
								<a href={`/blog/${post.data.slug}/`}>
									{post.data.feature_image && (
										<img src={post.data.feature_image} alt={post.data.feature_image_alt ?? ''} />
									)}
									<div class="post-card-body">
										<div class="post-card-title">{post.data.title}</div>
										<div class="post-card-date">
											<FormattedDate date={post.data.date} />
										</div>
									</div>
								</a>
							</div>
						))}
					</div>
				</section>
			)}

			<section>
				<p class="section-heading">Recent posts</p>
				<ul class="post-list">
					{recentPosts.map((post) => (
						<li class="post-list-item">
							<a href={`/blog/${post.data.slug}/`}>{post.data.title}</a>
							<span class="post-list-date">
								<FormattedDate date={post.data.date} />
							</span>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
