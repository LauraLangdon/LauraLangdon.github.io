<picture>
	<source srcset="{{img_url archive_image size="l" format="webp"}} 800w,
					{{img_url archive_image size="xl" format="webp"}} 1200w,
					{{img_url archive_image size="xxl" format="webp"}} 1600w"
			sizes="(max-width:480px) 800px, (max-width:1024px) 1200px, 1600px"
			type="image/webp">
	<img srcset="{{img_url archive_image size="l"}} 800w,
				 {{img_url archive_image size="xl"}} 1200w,
				 {{img_url archive_image size="xxl"}} 1600w"
		 sizes="(max-width:480px) 800px, (max-width:1024px) 1200px, 1600px"
		 src="{{img_url archive_image size="xxl"}}"
		 loading="lazy"
		 alt="{{alt}}">
</picture>