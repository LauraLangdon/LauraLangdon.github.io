---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import ShareLinks from '../components/ShareLinks.astro';
import { tagColor, visibleTags as getVisibleTags } from '../utils/tag-colors';

type PostLink = { title: string; slug: string } | null;

type Props = {
	title: string;
	slug: string;
	description?: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
	heroImageAlt?: string;
	tags?: string[];
	prevPost?: PostLink;
	nextPost?: PostLink;
};

const { title, slug, description, pubDate, updatedDate, heroImage, heroImageAlt, tags, prevPost, nextPost } = Astro.props;
const visibleTags = getVisibleTags(tags);
---

<html lang="en">
	<head>
		<BaseHead title={`${title} · ${SITE_TITLE}`} description={description} />
		<style>
			.post-banner {
				display: flex;
				gap: 2.5rem;
				align-items: center;
				margin-bottom: 2.5rem;
				padding: 2.5rem;
				background: var(--bg-card);
				border-radius: 16px;
			}
			.post-header {
				flex: 1;
				min-width: 0;
			}
			.hero-image {
				flex-shrink: 0;
				width: 320px;
				height: 280px;
				overflow: hidden;
				border-radius: 12px;
			}
			.hero-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.post-meta {
				font-family: monospace;
				color: var(--text-muted);
				margin: 0.75rem 0 0 0;
			}
			.post-meta-line {
				display: flex;
				align-items: baseline;
				gap: 0.5rem;
				margin: 0;
				font-size: var(--mono-meta);
			}
			.post-author {
				font-size: var(--mono-body);
				font-weight: 700;
			}
			.post-date {
				font-size: var(--mono-meta);
			}
			.meta-sep {
				font-weight: 700;
				color: var(--accent);
			}
			.post-title {
				font-size: 2.5rem;
				line-height: 1.2;
				margin: 0.5rem 0 0 0;
			}
			.last-updated {
				font-family: monospace;
				font-size: var(--mono-meta);
				color: var(--text-muted);
				font-style: italic;
				margin-top: 0.25rem;
			}
			@media (max-width: 720px) {
				.post-banner {
					flex-direction: column;
					gap: 1.5rem;
				}
				.hero-image {
					width: 100%;
					height: auto;
					max-height: 300px;
				}
				.post-title {
					font-size: 1.8rem;
				}
			}
			article {
				max-width: 820px;
				margin: 0 auto;
			}
			.prose {
				max-width: 680px;
				margin: 0 auto;
			}
			.prose :global(h2),
			.prose :global(h3),
			.prose :global(h4) {
				margin-top: 1.25em;
				color: var(--text);
			}
			.prose :global(h2:first-child) {
				font-family: monospace;
				font-size: var(--mono-section-heading);
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--accent);
				margin-top: 0;
			}
			.prose :global(a) {
				color: var(--accent-2);
			}
			.prose :global(a:hover) {
				color: var(--accent);
			}
			.prose :global(figure) {
				margin: 1.5em 0;
				width: 100%;
			}
			.prose :global(img) {
				border-radius: 8px;
				width: 100%;
				height: auto;
			}
			.prose :global(pre) {
				background-color: var(--code-bg);
				border: 1px solid var(--border);
				position: relative;
			}
			.prose :global(.copy-btn) {
				position: absolute;
				top: 8px;
				right: 8px;
				padding: 4px 10px;
				font-family: monospace;
				font-size: var(--mono-small);
				color: var(--text-muted);
				background: var(--bg);
				border: 1px solid var(--border);
				border-radius: 4px;
				cursor: pointer;
			}
			.prose :global(.copy-btn:hover) {
				color: var(--accent);
				border-color: var(--accent);
			}
			.prose :global(blockquote) {
				border-left-color: var(--accent);
				color: var(--text-muted);
			}
			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem;
				margin-top: 0.5rem;
			}
			.tag {
				font-family: monospace;
				font-size: var(--mono-small);
				color: var(--tag-text);
				font-weight: 700;
				background: color-mix(in srgb, var(--tag-color) 45%, white);
				border: 1px solid var(--tag-color);
				border-radius: 999px;
				padding: 0.1rem 0.5rem;
				text-decoration: none;
				transition: color 0.15s ease, border-color 0.15s ease;
			}
			.tag:hover {
				background: color-mix(in srgb, var(--tag-color) 60%, white);
				text-decoration: none;
			}
			.back-link {
				display: inline-block;
				font-family: monospace;
				font-size: var(--mono-body);
				color: var(--accent);
				text-decoration: none;
				margin-bottom: 2.5rem;
			}
			.back-link:hover {
				color: var(--accent-2);
			}
			.post-nav-wrapper {
				margin-top: 3rem;
				padding-top: 2rem;
				padding-bottom: 4rem;
				border-top: 1px solid var(--border);
			}
			.post-nav {
				display: flex;
				justify-content: space-between;
				gap: 2rem;
				max-width: 680px;
				margin: 0 auto;
			}
			.post-nav-link {
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
				text-decoration: none;
				max-width: 45%;
			}
			.post-nav-prev {
				align-items: flex-start;
			}
			.post-nav-next {
				align-items: flex-end;
				margin-left: auto;
			}
			.post-nav-label {
				font-family: monospace;
				font-size: var(--mono-meta);
				color: var(--accent);
			}
			.post-nav-title {
				font-size: 1rem;
				color: var(--text);
				line-height: 1.4;
			}
			.post-nav-link:hover .post-nav-title {
				color: var(--accent);
			}
			@media (max-width: 600px) {
				.post-nav-title {
					display: none;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<ShareLinks title={title} slug={slug} />
		<main>
			<a href="/blog" class="back-link">← All posts</a>
			<article>
				<div class="post-banner">
					{heroImage && (
						<div class="hero-image">
							<Image src={heroImage} alt={heroImageAlt ?? ''} width={320} height={280} />
						</div>
					)}
					<div class="post-header">
						<h1 class="post-title">{title}</h1>
						<div class="post-meta">
							<p class="post-meta-line">
								<span class="post-author">Laura Langdon</span>
								<span class="meta-sep">//</span>
								<span class="post-date">
									<FormattedDate date={pubDate} />
									{updatedDate && (
										<span class="last-updated"> · Updated <FormattedDate date={updatedDate} /></span>
									)}
								</span>
							</p>
							{visibleTags.length > 0 && (
								<div class="post-tags">
									{visibleTags.map((tag) => {
										const c = tagColor(tag);
										return <a href={`/blog/tag/${tag.toLowerCase().replaceAll(' ', '-')}/`} class="tag" style={`--tag-color: ${c.color};`}>{tag}</a>;
									})}
								</div>
							)}
						</div>
					</div>
				</div>
				<div class="prose">
					<slot />
				</div>
				{(prevPost || nextPost) && (
					<div class="post-nav-wrapper">
						<nav class="post-nav">
							{prevPost ? (
								<a href={`/blog/${prevPost.slug}/`} class="post-nav-link post-nav-prev">
									<span class="post-nav-label">← Older</span>
									<span class="post-nav-title">{prevPost.title}</span>
								</a>
							) : <div />}
							{nextPost ? (
								<a href={`/blog/${nextPost.slug}/`} class="post-nav-link post-nav-next">
									<span class="post-nav-label">Newer →</span>
									<span class="post-nav-title">{nextPost.title}</span>
								</a>
							) : <div />}
						</nav>
					</div>
				)}
				</article>
		</main>
		<Footer />
		<script>
			document.querySelectorAll('pre.astro-code').forEach((pre) => {
				// Set indent-aware wrapping on each line
				pre.querySelectorAll('.line').forEach((line) => {
					const text = line.textContent ?? '';
					const leading = text.match(/^(\s*)/)?.[1].length ?? 0;
					const indent = leading + 2; // extra 2ch for wrap continuation
					(line as HTMLElement).style.paddingLeft = `${indent}ch`;
					(line as HTMLElement).style.textIndent = `-${indent}ch`;
				});

				const btn = document.createElement('button');
				btn.className = 'copy-btn';
				btn.textContent = 'Copy';
				btn.addEventListener('click', async () => {
					const code = pre.querySelector('code');
					await navigator.clipboard.writeText(code?.textContent ?? '');
					btn.textContent = 'Copied!';
					setTimeout(() => { btn.textContent = 'Copy'; }, 1500);
				});
				pre.appendChild(btn);
			});
		</script>
	</body>
</html>
