<picture>
	<source srcset="{{img_url profile_image size="s" format="webp"}} 400w,
					{{img_url profile_image size="m" format="webp"}} 600w,
					{{img_url profile_image size="l" format="webp"}} 800w"
			sizes="(max-width:480px) 260px, 200px"
			type="image/webp">
	<img srcset="{{img_url profile_image size="s"}} 400w,
				 {{img_url profile_image size="m"}} 600w,
				 {{img_url profile_image size="l"}} 800w"
		 sizes="(max-width:480px) 260px, 200px"
		 src="{{img_url profile_image size="s"}}"
		 loading="lazy"
		 alt="{{name}}">
</picture>