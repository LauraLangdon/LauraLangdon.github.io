---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

type Props = {
	title: string;
	description?: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
	heroImageAlt?: string;
};

const { title, description, pubDate, updatedDate, heroImage, heroImageAlt } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={`${title} · ${SITE_TITLE}`} description={description} />
		<style>
			.hero-image {
				width: 100%;
				max-height: 480px;
				overflow: hidden;
				border-radius: 12px;
				margin: 0 auto 2.5rem;
			}
			.hero-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.post-header {
				margin-bottom: 2.5rem;
			}
			.post-meta {
				font-family: monospace;
				font-size: var(--mono-body);
				color: var(--text-muted);
				margin: 0 0 1rem 0;
			}
			.post-title {
				font-size: 2.5rem;
				line-height: 1.2;
				margin: 0 0 0.5rem 0;
			}
			.last-updated {
				font-family: monospace;
				font-size: var(--mono-meta);
				color: var(--text-muted);
				font-style: italic;
				margin-top: 0.25rem;
			}
			article {
				max-width: 680px;
				margin: 0 auto;
			}
			.prose {
				max-width: 680px;
			}
			.prose :global(h2),
			.prose :global(h3),
			.prose :global(h4) {
				margin-top: 2em;
				color: var(--text);
			}
			.prose :global(a) {
				color: var(--accent-2);
			}
			.prose :global(a:hover) {
				color: var(--accent);
			}
			.prose :global(figure) {
				margin: 1.5em 0;
				width: 100%;
			}
			.prose :global(img) {
				border-radius: 8px;
				width: 100%;
				height: auto;
			}
			.prose :global(pre) {
				background-color: var(--code-bg);
				border: 1px solid var(--border);
				position: relative;
			}
			.prose :global(.copy-btn) {
				position: absolute;
				top: 8px;
				right: 8px;
				padding: 4px 10px;
				font-family: monospace;
				font-size: var(--mono-small);
				color: var(--text-muted);
				background: var(--bg);
				border: 1px solid var(--border);
				border-radius: 4px;
				cursor: pointer;
			}
			.prose :global(.copy-btn:hover) {
				color: var(--accent);
				border-color: var(--accent);
			}
			.prose :global(blockquote) {
				border-left-color: var(--accent);
				color: var(--text-muted);
			}
			.back-link {
				display: inline-block;
				font-family: monospace;
				font-size: var(--mono-body);
				color: var(--text-muted);
				text-decoration: none;
				margin-bottom: 2.5rem;
			}
			.back-link:hover {
				color: var(--accent);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<a href="/blog" class="back-link">← All posts</a>
			<article>
				{heroImage && (
					<div class="hero-image">
						<img src={heroImage} alt={heroImageAlt ?? ''} />
					</div>
				)}
				<div class="post-header">
					<p class="post-meta">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="last-updated"> · Updated <FormattedDate date={updatedDate} /></span>
						)}
					</p>
					<h1 class="post-title">{title}</h1>
				</div>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
		<script>
			document.querySelectorAll('pre.astro-code').forEach((pre) => {
				// Set indent-aware wrapping on each line
				pre.querySelectorAll('.line').forEach((line) => {
					const text = line.textContent ?? '';
					const leading = text.match(/^(\s*)/)?.[1].length ?? 0;
					const indent = leading + 2; // extra 2ch for wrap continuation
					(line as HTMLElement).style.paddingLeft = `${indent}ch`;
					(line as HTMLElement).style.textIndent = `-${indent}ch`;
				});

				const btn = document.createElement('button');
				btn.className = 'copy-btn';
				btn.textContent = 'Copy';
				btn.addEventListener('click', async () => {
					const code = pre.querySelector('code');
					await navigator.clipboard.writeText(code?.textContent ?? '');
					btn.textContent = 'Copied!';
					setTimeout(() => { btn.textContent = 'Copy'; }, 1500);
				});
				pre.appendChild(btn);
			});
		</script>
	</body>
</html>
