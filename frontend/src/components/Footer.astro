---
import SubscribeWidget from './SubscribeWidget.astro';
import { siGithub, siMastodon, siBluesky, siRss } from 'simple-icons';

const today = new Date();

const linkedinPath = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';

const links = [
	{ href: 'https://github.com/LauraLangdon', label: 'GitHub', icon: siGithub.path },
	{ href: 'https://hachyderm.io/@LauraLangdon', label: 'Mastodon', rel: 'me', icon: siMastodon.path },
	{ href: 'https://bsky.app/profile/lauralangdon.io', label: 'Bluesky', icon: siBluesky.path },
	{ href: 'https://linkedin.com/in/laura-langdon', label: 'LinkedIn', icon: linkedinPath },
	{ href: '/rss.xml', label: 'RSS', icon: siRss.path },
];
---

<footer>
	<div class="footer-inner">
		<span class="copyright">&copy; {today.getFullYear()} Laura Langdon</span>
		<nav class="footer-links">
			{links.map(({ href, label, rel, icon }) => (
				<a href={href} aria-label={label} rel={rel} title={label}>
					<svg
						role="img"
						viewBox="0 0 24 24"
						xmlns="http://www.w3.org/2000/svg"
						aria-hidden="true"
					>
						<path d={icon} />
					</svg>
				</a>
			))}
		</nav>
	</div>
</footer>
<SubscribeWidget />

<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 2rem 1.5em;
		margin-top: 2rem;
	}
	.footer-inner {
		max-width: 960px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.copyright {
		font-family: monospace;
		font-size: var(--mono-body);
		color: var(--text-muted);
	}
	.footer-links {
		display: flex;
		gap: 1.25rem;
		align-items: center;
	}
	.footer-links a {
		display: flex;
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.footer-links a:hover {
		color: var(--accent);
	}
	.footer-links svg {
		width: 18px;
		height: 18px;
		fill: currentColor;
	}
	@media (max-width: 720px) {
		.footer-inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
