<footer class="footer-section global-footer">
	<div class="footer-wrap">
		<div class="footer-data">
			<div class="footer-logo">
				{{>logo}}
			</div>
			{{#if @site.description}}
			<p class="footer-description">{{@site.description}}</p>
			{{/if}}
			<div class="footer-icons">
				{{#if @site.facebook}}
				<a href='{{social_url type="facebook"}}' aria-label="link Facebook">{{>icons/social/facebook}}</a>
				{{/if}}
				{{#if @site.twitter}}
				<a href='{{social_url type="twitter"}}' aria-label="link X">{{>icons/social/x}}</a>
				{{/if}}
				{{>footer_icons}}
			</div>
		</div>
		<div class="footer-nav">
			{{#if @site.secondary_navigation}}
			{{navigation type="secondary"}}
			{{/if}}
		</div>
	</div>
	<div class="footer-copyright">
		&copy; {{date format="YYYY"}} <a href="{{@site.url}}">{{@site.title}}</a>.
		{{#if @custom.footer_copyright}}
		{{{@custom.footer_copyright}}}
		{{else}}
		{{{t "All Rights Reserved. "}}}
		{{/if}}
	</div>
</footer>