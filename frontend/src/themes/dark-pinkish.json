{
  "name": "dark-pinkish",
  "displayName": "Dark Pinkish",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#120128",
    "editor.foreground": "#dfafe9"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#dfafe9"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#8a7093",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ea5ea8"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "string punctuation.section.embedded source"
      ],
      "settings": {
        "foreground": "#ffc466"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#01c7e0"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#9998ff"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#c96ef7"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#00cc99"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#c96ef7",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter.function"
      ],
      "settings": {
        "foreground": "#dfafe9"
      }
    },
    {
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#01c7e0"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#f8b9d2"
      }
    },
    {
      "scope": [
        "support",
        "support.constant",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#9998ff"
      }
    },
    {
      "scope": [
        "source.regexp",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#00cc99"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#9998ff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#00cc99"
      }
    },
    {
      "scope": ["markup.inline.raw"],
      "settings": {
        "foreground": "#ffc466"
      }
    },
    {
      "scope": [
        "constant.other.reference.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#9998ff",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#ea5ea8"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#00cc99"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.broken",
        "invalid.deprecated",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#EB4F9F",
        "fontStyle": "italic"
      }
    }
  ]
}
