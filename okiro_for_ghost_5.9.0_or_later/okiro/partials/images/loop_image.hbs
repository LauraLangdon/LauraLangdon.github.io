<picture>
	<source srcset="{{img_url feature_image size="s" format="webp"}} 400w,
					{{img_url feature_image size="m" format="webp"}} 600w, 
					{{img_url feature_image size="l" format="webp"}} 800w,
					{{img_url feature_image size="xl" format="webp"}} 1200w"
			sizes="(max-width:480px) 350px, 500px"
			type="image/webp">	
	<img srcset="{{img_url feature_image size="s"}} 400w,
				 {{img_url feature_image size="m"}} 600w, 
				 {{img_url feature_image size="l"}} 800w,
				 {{img_url feature_image size="xl"}} 1200w"
		 sizes="(max-width:480px) 350px, 500px"
		 src="{{img_url feature_image size="m"}}"
		 loading="lazy"
		 alt="{{title}}">
</picture>