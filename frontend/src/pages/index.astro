---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import { siGithub, siMastodon, siBluesky, siTwitch, siYoutube } from 'simple-icons';

const linkedinPath = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';

const heroLinks = [
	{ href: 'https://github.com/LauraLangdon', label: 'GitHub', icon: siGithub.path },
	{ href: 'https://hachyderm.io/@LauraLangdon', label: 'Mastodon', rel: 'me', icon: siMastodon.path },
	{ href: 'https://bsky.app/profile/lauralangdon.io', label: 'Bluesky', icon: siBluesky.path },
	{ href: 'https://linkedin.com/in/laura-langdon', label: 'LinkedIn', icon: linkedinPath },
	{ href: 'https://twitch.tv/LauraLangdon', label: 'Twitch', icon: siTwitch.path },
	{ href: 'https://youtube.com/@laura-langdon', label: 'YouTube', icon: siYoutube.path },
];

const allPosts = await getCollection('blog');
const publishedPosts = allPosts
	.filter((p) => p.data.status === 'published')
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featuredOrder = [
	'real-time-collaborative-sessions-for-new-contributors-and-maintainers',
	'my-ultra-ergo-keyboard-setup',
	'from-campus-to-network-creating-the-uc-system-wide-ospo-initiative',
];
const featuredPosts = featuredOrder
	.map((slug) => publishedPosts.find((p) => p.data.slug === slug))
	.filter(Boolean);
const recentPosts = publishedPosts.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 6rem;
				padding: 3rem 2.5rem;
				border-bottom: none;
				background: var(--bg-card);
				border-radius: 16px;
				margin-bottom: 1rem;
			}
			.hero-photo {
				flex-shrink: 0;
				width: 180px;
				height: 180px;
				border-radius: 50%;
				border: 3px solid var(--accent);
				background-color: #120128;
				background-image: url('/profile.png');
				background-size: cover;
				background-position: center 20%;
			}
			.hero-content {
				max-width: 540px;
			}
			.hero-name {
				font-family: monospace;
				font-size: var(--mono-hero);
				font-weight: 700;
				margin: 0 0 0.25rem 0;
				background: linear-gradient(90deg, var(--accent), var(--accent-2));
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}
			.hero-tagline {
				font-family: monospace;
				color: var(--text-muted);
				font-size: var(--mono-body);
				margin: 0 0 1.25rem 0;
				letter-spacing: 0.05em;
			}
			.hero-bio {
				font-size: 1.05rem;
				line-height: 1.7;
				color: var(--text);
				margin: 0;
				max-width: 540px;
			}
			section {
				padding: 3rem 0;
				border-bottom: 1px solid var(--border);
			}
			section:last-child {
				border-bottom: none;
			}
			.section-heading {
				font-family: monospace;
				font-size: var(--mono-section-heading);
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--text-muted);
				margin: 0 0 2rem 0;
			}
			.post-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5rem;
			}
			.post-card {
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: 12px;
				overflow: hidden;
				transition: box-shadow 0.2s ease, transform 0.2s ease;
			}
			.post-card:hover {
				box-shadow: var(--box-shadow);
				transform: translateY(-2px);
			}
			.post-card a {
				display: flex;
				flex-direction: column;
				height: 100%;
				color: inherit;
				text-decoration: none;
			}
			.post-card img {
				width: 100%;
				height: 160px;
				object-fit: cover;
				border-radius: 0;
			}
			.post-card-body {
				padding: 1.25rem;
				flex: 1;
				display: flex;
				flex-direction: column;
			}
			.post-card-title {
				font-size: 1.1rem;
				font-weight: 700;
				margin: 0 0 0.5rem 0;
				line-height: 1.3;
				color: var(--text);
			}
			.post-card-date {
				font-family: monospace;
				font-size: var(--mono-meta);
				color: var(--text-muted);
				margin-top: auto;
			}
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0;
			}
			.post-list-item {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
				padding: 0.85rem 0;
				border-bottom: 1px solid var(--border);
			}
			.post-list-item:last-child {
				border-bottom: none;
			}
			.post-list-item a {
				color: var(--text);
				font-weight: 500;
			}
			.post-list-item a:hover {
				color: var(--accent);
				text-decoration: none;
			}
			.post-list-date {
				font-family: monospace;
				font-size: var(--mono-meta);
				color: var(--text-muted);
				white-space: nowrap;
			}
			.hero-links {
				display: flex;
				flex-wrap: wrap;
				gap: 1.25rem;
				margin-top: 1.25rem;
				align-items: center;
			}
			.hero-links a {
				display: flex;
				color: var(--text-muted);
				text-decoration: none;
				transition: color 0.2s ease;
			}
			.hero-links a:hover {
				color: var(--accent);
			}
			.hero-links svg {
				width: 20px;
				height: 20px;
				fill: currentColor;
			}
			@media (max-width: 720px) {
				.hero {
					flex-direction: column;
					text-align: center;
					gap: 1.5rem;
					padding: 2rem 1.5rem;
				}
				.hero-bio {
					max-width: 100%;
				}
				.hero-name {
					font-size: var(--mono-page-heading);
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-photo" role="img" aria-label="Laura Langdon"></div>
				<div class="hero-content">
					<h1 class="hero-name">Laura Langdon</h1>
					<p class="hero-tagline">// Community Manager · UC OSPO Network</p>
					<p class="hero-bio">
						Hello! I'm Laura, and I'm passionate about community, diversity and
						inclusion across all axes, and open source as a force for public good. I find
						camaraderie with folks who value social responsibility in tech and are
						enormous nerds.
					</p>
					<nav class="hero-links">
						{heroLinks.map(({ href, label, rel, icon }) => (
							<a href={href} aria-label={label} rel={rel} title={label}>
								<svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path d={icon} />
								</svg>
							</a>
						))}
					</nav>
				</div>
			</section>

			{featuredPosts.length > 0 && (
				<section>
					<p class="section-heading">Featured</p>
					<div class="post-grid">
						{featuredPosts.map((post) => (
							<div class="post-card">
								<a href={`/blog/${post.data.slug}/`}>
									{post.data.feature_image && (
										<img src={post.data.feature_image} alt={post.data.feature_image_alt ?? ''} />
									)}
									<div class="post-card-body">
										<div class="post-card-title">{post.data.title}</div>
										<div class="post-card-date">
											<FormattedDate date={post.data.date} />
										</div>
									</div>
								</a>
							</div>
						))}
					</div>
				</section>
			)}

			<section>
				<p class="section-heading">Recent posts</p>
				<ul class="post-list">
					{recentPosts.map((post) => (
						<li class="post-list-item">
							<a href={`/blog/${post.data.slug}/`}>{post.data.title}</a>
							<span class="post-list-date">
								<FormattedDate date={post.data.date} />
							</span>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
