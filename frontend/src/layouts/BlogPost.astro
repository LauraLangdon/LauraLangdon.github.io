---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

type Props = {
	title: string;
	description?: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
};

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={`${title} · ${SITE_TITLE}`} description={description} />
		<style>
			.hero-image {
				width: 100%;
				max-height: 480px;
				overflow: hidden;
				border-radius: 12px;
				margin-bottom: 2.5rem;
			}
			.hero-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.post-header {
				margin-bottom: 2.5rem;
			}
			.post-meta {
				font-family: monospace;
				font-size: 0.8rem;
				color: var(--text-muted);
				margin: 0 0 1rem 0;
			}
			.post-title {
				font-size: 2.5rem;
				line-height: 1.2;
				margin: 0 0 0.5rem 0;
			}
			.last-updated {
				font-family: monospace;
				font-size: 0.8rem;
				color: var(--text-muted);
				font-style: italic;
				margin-top: 0.25rem;
			}
			.prose {
				max-width: 680px;
			}
			.prose :global(h2),
			.prose :global(h3),
			.prose :global(h4) {
				margin-top: 2em;
				color: var(--text);
			}
			.prose :global(a) {
				color: var(--accent-2);
			}
			.prose :global(a:hover) {
				color: var(--accent);
			}
			.prose :global(img) {
				border-radius: 8px;
				margin: 1.5em 0;
			}
			.prose :global(pre) {
				background-color: var(--code-bg);
				border: 1px solid var(--border);
			}
			.prose :global(blockquote) {
				border-left-color: var(--accent);
				color: var(--text-muted);
			}
			.back-link {
				display: inline-block;
				font-family: monospace;
				font-size: 0.85rem;
				color: var(--text-muted);
				text-decoration: none;
				margin-bottom: 2.5rem;
			}
			.back-link:hover {
				color: var(--accent);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<a href="/blog" class="back-link">← All posts</a>
			<article>
				{heroImage && (
					<div class="hero-image">
						<img src={heroImage} alt="" />
					</div>
				)}
				<div class="post-header">
					<p class="post-meta">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="last-updated"> · Updated <FormattedDate date={updatedDate} /></span>
						)}
					</p>
					<h1 class="post-title">{title}</h1>
				</div>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
