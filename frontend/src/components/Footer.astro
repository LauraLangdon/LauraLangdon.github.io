---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<span class="copyright">&copy; {today.getFullYear()} Laura Langdon</span>
		<nav class="footer-links">
			<a href="https://github.com/LauraLangdon">GitHub</a>
			<a href="https://hachyderm.io/@LauraLangdon" rel="me">Mastodon</a>
			<a href="https://bsky.app/profile/lauralangdon.io">Bluesky</a>
			<a href="/rss.xml">RSS</a>
		</nav>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 2rem 1.5em;
		margin-top: 2rem;
	}
	.footer-inner {
		max-width: 960px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.copyright {
		font-family: monospace;
		font-size: 0.8rem;
		color: var(--text-muted);
	}
	.footer-links {
		display: flex;
		gap: 1.25rem;
	}
	.footer-links a {
		font-family: monospace;
		font-size: 0.8rem;
		color: var(--text-muted);
		text-decoration: none;
	}
	.footer-links a:hover {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		.footer-inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
