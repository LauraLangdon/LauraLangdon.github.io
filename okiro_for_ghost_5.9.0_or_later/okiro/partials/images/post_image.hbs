<picture>
	<source srcset="{{img_url feature_image size="s" format="webp"}} 400w, 
					{{img_url feature_image size="l" format="webp"}} 800w,
					{{img_url feature_image size="xl" format="webp"}} 1200w,
					{{img_url feature_image size="xxl" format="webp"}} 1600w"
			sizes="(max-width:480px) 350px, (max-width:1440px) 800px, 1200px"
			type="image/webp">	
	<img srcset="{{img_url feature_image size="s"}} 400w, 
				 {{img_url feature_image size="l"}} 800w,
				 {{img_url feature_image size="xl"}} 1200w,
				 {{img_url feature_image size="xxl"}} 1600w"
		 sizes="(max-width:480px) 350px, (max-width:1440px) 800px, 1200px"
		 src="{{img_url feature_image size="xl"}}"
		 loading="lazy"
		 alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
</picture>